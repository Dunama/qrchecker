# --- Rental QR Tracker backend configuration ---
# Copy this file to `.env` and adjust values. Never commit your real `.env`.

# Secret used to sign QR tokens (HMAC-SHA256).
# REQUIRED in production. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# How long a generated QR token stays valid, in hours.
QR_EXPIRY_HOURS=72

# Log verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
